# Local dev only. Copy to .env.local and fill in with values printed by
# `npx supabase start`. The deployed ingestion worker does NOT read this file
# — it reads secrets from Azure Key Vault at cold start, per docs/AZURE.md.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Azure (reference only for local tooling — real values live in Key Vault)
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_STORAGE_ACCOUNT_NAME=
